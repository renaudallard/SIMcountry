<data-extraction-rules>
    <cloud-backup>
        <!-- Daemon RSA keypair: never back this up. The device's adbd trusts
             a specific public key; restoring on a new device would either
             leak the private key or carry a now-untrusted key. -->
        <exclude domain="file" path="adb_rsa.pkcs8" />
        <exclude domain="file" path="adb_rsa.x509" />
        <!-- Same data while AdbRsaKey.loadOrCreate is mid-rotation. -->
        <exclude domain="file" path="adb_rsa.pkcs8.tmp" />
        <exclude domain="file" path="adb_rsa.x509.tmp" />
        <!-- Autostart pair state references the same key, useless on a
             different device. -->
        <exclude domain="file" path="autostart.json" />
        <!-- User-visible state (rules, SIM nicknames, override suppressions)
             is fair game; users probably want it restored. -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="adb_rsa.pkcs8" />
        <exclude domain="file" path="adb_rsa.x509" />
        <exclude domain="file" path="adb_rsa.pkcs8.tmp" />
        <exclude domain="file" path="adb_rsa.x509.tmp" />
        <exclude domain="file" path="autostart.json" />
    </device-transfer>
</data-extraction-rules>
